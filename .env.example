# Strapi server-side API connection
SUN_API_URL=http://localhost:1337/api
# Create a read-only Strapi API token with find/findOne access for the
# content types and single types used by the frontend, then paste it here.
SUN_API_TOKEN=

# Public base used for Strapi media URLs and canonical metadata in local development
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set Strapi NEXT_REVALIDATE_URL to http://localhost:3000/api/revalidate.
# Must match Strapi's shared secret; replace this placeholder for deployments.
NEXT_REVALIDATE_SECRET=tobemodified
